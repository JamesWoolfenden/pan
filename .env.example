# Plex connection (leave blank to skip Plex ingestion)
PLEX_BASEURL=http://127.0.0.1:32400
PLEX_TOKEN=

# Optional: Plex's own filesystem prefix for its music library (e.g. a NAS path like
# /volume1/plexdata/music), if different from how this machine sees the same files via
# SHARED_DRIVE_PATH. Enables playback + correct dedup for Plex-sourced tracks.
PLEX_REMOTE_MUSIC_PATH=

# Shared drive of local audio files not necessarily in Plex (leave blank to skip)
SHARED_DRIVE_PATH=

# Claude API key - used for tagging gaps and complex NL query parsing
ANTHROPIC_API_KEY=

# Safety cap on how many tracks get sent to the Claude API per reindex run
CLOUD_TAGGING_MAX_PER_RUN=200

DB_PATH=pan.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
